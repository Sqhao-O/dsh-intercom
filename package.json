{
  "name": "dsh-intercom",
  "version": "0.0.0",
  "description": "Intercom plugin for DeepSeek Harness (dsh): discovery and messaging between independent dsh sessions on the same machine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "tsx --test broker/ask-timeout.test.ts broker/client.test.ts broker/client-liveness.test.ts broker/extension.test.ts broker/framing.test.ts broker/paths.test.ts broker/runtime-claim.test.ts broker/spawn.test.ts cwd.test.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs}": [
      "oxlint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
