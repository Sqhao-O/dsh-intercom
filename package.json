{
  "name": "dsh-intercom",
  "version": "1.0.0",
  "description": "Intercom plugin for DeepSeek Harness (dsh): discovery and messaging between independent dsh sessions on the same machine",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "main": "./lib/src/index.js",
  "exports": {
    ".": "./lib/src/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "setup-hooks": "simple-git-hooks",
    "test": "tsx --test broker/ask-timeout.test.ts broker/abuse.test.ts broker/client.test.ts broker/client-liveness.test.ts broker/extension.test.ts broker/framing.test.ts broker/paths.test.ts broker/runtime-claim.test.ts broker/spawn.test.ts cwd.test.ts tests/config.test.ts tests/config-lifecycle.test.ts tests/registry.test.ts tests/message.test.ts tests/reply-tracker.test.ts tests/transport-local.test.ts tests/tool.test.ts tests/tool-abort.test.ts tests/tool-broker.test.ts tests/docs.test.ts tests/intercom.integration.test.ts",
    "test:e2e": "tsx tests/e2e/run.ts",
    "test:install": "tsx tests/e2e/install-preview.ts",
    "test:panel": "tsx tests/e2e/panel.ts",
    "test:dod": "tsx tests/e2e/dod-install.ts",
    "test:accept": "node tests/accept/local-env.mjs",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs}": [
      "oxlint --fix"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-mock-server": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "unrun": "^0.3.1",
    "typescript": "^5.9.3"
  }
}
